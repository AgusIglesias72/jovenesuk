#!/bin/sh
# Pre-push del JUK Portal. Opt-in: se activa con `npm run hooks:install`
# (desde juk-portal/), que setea core.hooksPath=.githooks.
#
# Corre lo mismo que el job "check" del CI menos audit, build y E2E (esos
# quedan para el CI y para /juk-cierre): typecheck, lint, unit y test compañero.
# Emergencia (y solo emergencia): git push --no-verify

set -u

# Si el push solo borra ramas remotas no sube código: nada que chequear.
hay_codigo=0
while read -r _ref_local sha_local _ref_remota _sha_remota; do
  case "$sha_local" in
    *[!0]*) hay_codigo=1 ;;
  esac
done
[ "$hay_codigo" -eq 1 ] || exit 0

raiz=$(git rev-parse --show-toplevel) || exit 1
cd "$raiz/juk-portal" || {
  echo "pre-push: no encuentro $raiz/juk-portal" >&2
  exit 1
}

paso() {
  nombre=$1
  shift
  printf '\n>> pre-push: %s\n' "$nombre"
  if ! "$@"; then
    printf '\nXX pre-push: fallo "%s" y el push se cancelo.\n' "$nombre" >&2
    printf '   Arreglalo y volve a pushear. Si es una emergencia: git push --no-verify\n' >&2
    printf '   (el CI igual corre todo y va a quedar en rojo).\n\n' >&2
    exit 1
  fi
}

paso "typecheck" npm run typecheck
paso "lint" npm run lint
paso "unit tests" npm test
paso "test companero (check:tests)" npm run check:tests

printf '\n>> pre-push: todo verde.\n\n'
