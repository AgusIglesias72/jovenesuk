{
  "name": "juk-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:seed:demo": "tsx src/lib/db/seed-demo.ts",
    "trigger:dev": "npx trigger.dev@4.5.16 dev",
    "trigger:deploy": "npx trigger.dev@4.5.16 deploy",
    "email:dev": "email dev --dir src/lib/email/templates",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile",
    "check:tests": "node scripts/check-test-companions.mjs --base auto",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@neondatabase/serverless": "^0.10.0",
    "@react-email/components": "^0.0.30",
    "@react-email/render": "^1.0.0",
    "@sentry/nextjs": "^10.73.0",
    "@trigger.dev/sdk": "^4.5.16",
    "better-auth": "^1.7.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^4.0.0",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.5.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "react-email": "^3.0.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "ws": "^8.21.3",
    "socket.io-parser": "^4.2.7",
    "fast-uri": "^3.1.6",
    "@sentry/bundler-plugin-core": {
      "brace-expansion": "^5.0.9"
    }
  }
}
