# ============================================================
# JUK Portal · Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# DO NOT commit .env.local to git.
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# URL pública del sitio (canonicals, sitemap, OG images, JSON-LD). Sin barra final.
# En prod = el dominio definitivo del sitio público (ej. https://www.jovenesenuk.com).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# URL del subdominio del portal/gestión (ej. https://portal.jovenesenuk.com).
# Al setearla (+ apuntar el subdominio al mismo deployment) se activa la
# separación de dominios: gestión en portal.*, marketing en la raíz.
# NEXT_PUBLIC_PORTAL_URL="https://portal.jovenesenuk.com"

# Google Analytics 4: poné el Measurement ID para activar analytics (sin costo).
# Sin esto, el sitio no carga analytics.
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Search Console: token de verificación por meta tag (si verificás por HTML y
# no por DNS). Se obtiene en GSC → Agregar propiedad → Etiqueta HTML.
# NEXT_PUBLIC_GSC_VERIFICATION="xxxxxxxxxxxxxxxxxxxxxxxx"

# Mostrar la herramienta interna de diseño (?tweak) en un deploy no-dev (staging).
# Dejar sin setear en producción.
# NEXT_PUBLIC_ENABLE_TWEAK="1"

# --- Database (Neon Postgres, region sa-east-1) ---
# Get this from neon.tech → your project → Connection details → Pooled connection
DATABASE_URL="postgres://user:password@ep-xxx-pooler.sa-east-1.aws.neon.tech/juk?sslmode=require"

# Unpooled connection for migrations (only used by drizzle-kit)
DATABASE_URL_UNPOOLED="postgres://user:password@ep-xxx.sa-east-1.aws.neon.tech/juk?sslmode=require"

# --- Auth (Better-Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="<generate-32-byte-random-secret>"
BETTER_AUTH_URL="http://localhost:3000"

# --- Email (Resend) ---
# Get from resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM_ADDRESS="info@jovenesenuk.com"
EMAIL_FROM_NAME="Jóvenes en UK"
EMAIL_REPLY_TO="info@jovenesenuk.com"

# Remitente de comunicaciones transaccionales del portal (avisos a familias,
# recordatorios, etc.). Dominio verificado en Resend.
EMAIL_FROM_COMUNICACIONES="comunicaciones@jovenesenuk.com"

# Remitente de outreach del CRM de Prospectos (campañas de captación en frío).
# Va por un subdominio de marketing separado para no ensuciar la reputación
# del dominio transaccional principal.
EMAIL_FROM_OUTREACH="hola@mkt.jovenesenuk.com"

# Casilla interna que recibe la notificación cuando entra un lead nuevo
# (formulario del sitio público / alta de prospecto).
LEADS_NOTIFY_TO="leads@jovenesenuk.com"

# --- File storage (Cloudflare R2) ---
# Get from Cloudflare dashboard → R2 → API tokens
R2_ACCOUNT_ID="xxxxxxxxxxxx"
R2_ACCESS_KEY_ID="xxxxxxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxxxxxx"
R2_BUCKET_NAME="juk-documents"
# El bucket tiene que ser PRIVADO (sin dominio público ni r2.dev): los
# documentos (pasaportes, consentimientos) se sirven siempre por
# /api/uploads/<key>, autenticado. No configurar R2_PUBLIC_URL.

# --- Background jobs (Trigger.dev) ---
# Get from cloud.trigger.dev → Project → Settings → API Keys
TRIGGER_SECRET_KEY="tr_dev_xxxxxxxx"
TRIGGER_PROJECT_ID="proj_xxxxxxxx"

# --- Observability (Sentry) ---
# DSN del proyecto (Sentry → Settings → Client Keys). Es público pero NO va
# en el código: sin esta var Sentry queda desactivado (y en prod se loguea
# un aviso). También se usa como report-uri de la CSP en next.config.ts.
NEXT_PUBLIC_SENTRY_DSN="https://xxxxx@oXXXXX.ingest.us.sentry.io/xxxxxx"

# Solo para subir source maps en el build (withSentryConfig en next.config.ts).
# Con las tres seteadas se activa; sin ellas el build no toca Sentry.
# Token: Sentry → Settings → Auth Tokens, con scope project:releases.
# SENTRY_AUTH_TOKEN="sntrys_xxxxxxxx"
# SENTRY_ORG="juk"
# SENTRY_PROJECT="portal"

# --- Seed y tests ---
# Password de los usuarios de prueba que crea `npm run db:seed:demo`
# (test.superadmin@ / test.admin@jovenesenuk.com) y que usan los E2E.
# Requerido para db:seed:demo y para correr Playwright. Solo dev/CI.
SEED_TEST_PASSWORD="<elegí-una-password-de-prueba>"

# --- Webhooks ---
# Generate a random shared secret for webhook validation
GOOGLE_FORM_WEBHOOK_SECRET="<generate-random-secret>"

# Secreto de firma del webhook de Resend (eventos de entrega/apertura/bounce
# para el CRM de Prospectos). Se obtiene en resend.com → Webhooks al crear el
# endpoint (/api/webhooks/resend). Empieza con "whsec_".
RESEND_WEBHOOK_SECRET="whsec_xxxx"
