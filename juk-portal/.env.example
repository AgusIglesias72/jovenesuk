# ============================================================
# JUK Portal · Variables de entorno
# ============================================================
# Copiá este archivo a .env.local y completá los valores.
# .env.local NO se commitea.
#
# Qué falta y qué quedó con un valor de ejemplo:  npm run check:env
# Lo que tiene que estar en un deploy:            npm run check:env -- --prod
# Paso a paso de cada servicio:                   docs/setup-servicios.md
#
# Las líneas comentadas son opcionales: activan algo, y sin ellas la app anda.
# El catálogo (qué habilita cada una y qué pasa si falta) vive en
# src/lib/domain/configuracion/env.ts, y es el que lee `check:env`.
# ============================================================

# --- App: URLs públicas ---
# Base de las URLs que se arman en el server (links de los mails, cliente de auth).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# URL pública del sitio (canonicals, sitemap, OG, JSON-LD). Sin barra final.
# En producción, el dominio definitivo (ej. https://www.jovenesenuk.com).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Subdominio del portal de gestión. Al setearla (+ apuntar el DNS al mismo
# deployment) se separa gestión en portal.* de marketing en la raíz.
# NEXT_PUBLIC_PORTAL_URL="https://portal.jovenesenuk.com"

# --- Base de datos (Neon Postgres, región sa-east-1) ---
# neon.tech → tu proyecto → Connection details → Pooled connection.
# Sin esta variable la app no arranca ni compila.
DATABASE_URL="postgres://user:password@ep-xxx-pooler.sa-east-1.aws.neon.tech/juk?sslmode=require"

# Conexión directa (sin pooler) para las migraciones: solo la usa drizzle-kit.
DATABASE_URL_UNPOOLED="postgres://user:password@ep-xxx.sa-east-1.aws.neon.tech/juk?sslmode=require"

# --- Login (Better-Auth) ---
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET="<generate-32-byte-random-secret>"
BETTER_AUTH_URL="http://localhost:3000"

# --- Email (Resend) ---
# resend.com → API Keys. Sin key, fuera de producción los mails se renderizan y
# se loguean sin salir. OJO: una key de ejemplo (re_xxxx) apaga ese dry-run y los
# envíos fallan: dejala vacía o activá EMAIL_DRY_RUN=1.
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM_ADDRESS="info@jovenesenuk.com"
EMAIL_FROM_NAME="Jóvenes en UK"
EMAIL_REPLY_TO="info@jovenesenuk.com"

# Remitente de lo que espera respuesta (credenciales, cancelaciones).
EMAIL_FROM_COMUNICACIONES="comunicaciones@jovenesenuk.com"

# Remitente del outreach del CRM de Prospectos (captación en frío). Va por un
# subdominio de marketing separado, para no gastar la reputación del dominio
# transaccional.
EMAIL_FROM_OUTREACH="hola@mkt.jovenesenuk.com"

# Casilla interna que recibe el aviso de una consulta nueva.
LEADS_NOTIFY_TO="leads@jovenesenuk.com"

# --- Documentos (Cloudflare R2) ---
# Cloudflare → R2 → API tokens. Las cuatro van juntas.
# El bucket tiene que ser PRIVADO (sin dominio público ni r2.dev): los documentos
# (pasaportes, consentimientos) se sirven siempre por /api/uploads/<key>, con
# sesión y dueño verificado. No existe R2_PUBLIC_URL.
# En local, sin estas variables, los archivos van a .uploads/ (fallback a disco).
R2_ACCOUNT_ID="xxxxxxxxxxxx"
R2_ACCESS_KEY_ID="xxxxxxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxxxxxx"
R2_BUCKET_NAME="juk-documents"

# --- Jobs (Trigger.dev) ---
# cloud.trigger.dev → Project → Settings → API Keys.
# Sin esto no hay recordatorios automáticos, A1 no vence solo y los viajes no
# cambian de estado por fecha.
TRIGGER_SECRET_KEY="tr_dev_xxxxxxxx"
TRIGGER_PROJECT_ID="proj_xxxxxxxx"

# --- Errores (Sentry) ---
# DSN del proyecto (Sentry → Settings → Client Keys). Es público, pero igual no
# va en el código: sin esta variable Sentry queda desactivado y la CSP no reporta.
NEXT_PUBLIC_SENTRY_DSN="https://xxxxx@oXXXXX.ingest.us.sentry.io/xxxxxx"

# Source maps en el build (withSentryConfig). Con las tres se activa; sin ellas
# el build no toca Sentry. Token: Sentry → Auth Tokens, scope project:releases.
# SENTRY_AUTH_TOKEN="sntrys_xxxxxxxx"
# SENTRY_ORG="juk"
# SENTRY_PROJECT="portal"

# --- Webhooks ---
# Secreto compartido con el Google Form (32+ caracteres, generalo al azar).
# Sin esto el webhook rechaza todo con 401.
GOOGLE_FORM_WEBHOOK_SECRET="<generate-random-secret>"

# Firma del webhook de Resend (entregas, aperturas y bounces del CRM).
# resend.com → Webhooks, al crear el endpoint /api/webhooks/resend. Empieza con "whsec_".
RESEND_WEBHOOK_SECRET="whsec_xxxx"

# --- Analytics y SEO (opcionales) ---
# Google Analytics 4: el Measurement ID activa analytics.
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Search Console por meta tag (si no verificás por DNS).
# NEXT_PUBLIC_GSC_VERIFICATION="xxxxxxxxxxxxxxxxxxxxxxxx"

# Muestra el DesignTweaker del sitio público en un build que no es dev (staging).
# NUNCA en producción.
# NEXT_PUBLIC_ENABLE_TWEAK="1"

# --- Seeds y tests ---
# Contraseña de las cuentas test.* que crea `npm run db:seed:demo` y usan los
# E2E. Requerida para seedear la demo y para correr Playwright. Solo dev/CI.
SEED_TEST_PASSWORD="<elegí-una-password-de-prueba>"

# Renderiza los mails y los loguea sin enviarlos. Lo fijan Playwright y el CI;
# en dev sirve para no depender de Resend. NUNCA en producción.
# EMAIL_DRY_RUN="1"
