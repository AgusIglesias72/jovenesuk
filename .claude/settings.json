{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/domain-purity-check.mjs" },
          { "type": "command", "command": "node .claude/hooks/schema-change-reminder.mjs" },
          { "type": "command", "command": "node .claude/hooks/gated-module-warning.mjs" }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "PowerShell",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill",
      "TodoWrite",
      "NotebookEdit",
      "mcp__plugin_playwright_playwright",
      "mcp__shadcn-studio-mcp"
    ]
  }
}
