{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/destructive-command-guard.mjs\"", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/domain-purity-check.mjs\"", "timeout": 15 },
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/schema-change-reminder.mjs\"", "timeout": 15 },
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/gated-module-warning.mjs\"", "timeout": 15 },
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/test-companion-check.mjs\"", "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/docs-sync-reminder.mjs\"", "timeout": 30 }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "PowerShell",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill",
      "TodoWrite",
      "NotebookEdit",
      "mcp__plugin_playwright_playwright",
      "mcp__shadcn-studio-mcp"
    ],
    "ask": [
      "Bash(npm run db:migrate*)",
      "Bash(npx drizzle-kit migrate*)",
      "Bash(npm run db:seed*)",
      "Bash(npm run trigger:deploy*)",
      "Bash(npx trigger.dev* deploy*)",
      "Bash(vercel --prod*)",
      "Bash(vercel deploy --prod*)",
      "PowerShell(npm run db:migrate*)",
      "PowerShell(npx drizzle-kit migrate*)",
      "PowerShell(npm run db:seed*)",
      "PowerShell(npm run trigger:deploy*)",
      "PowerShell(npx trigger.dev* deploy*)",
      "PowerShell(vercel --prod*)",
      "PowerShell(vercel deploy --prod*)"
    ],
    "deny": [
      "Bash(npm run db:push*)",
      "Bash(npx drizzle-kit push*)",
      "Bash(npx drizzle-kit drop*)",
      "Bash(drizzle-kit push*)",
      "Bash(drizzle-kit drop*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean -f*)",
      "PowerShell(npm run db:push*)",
      "PowerShell(npx drizzle-kit push*)",
      "PowerShell(npx drizzle-kit drop*)",
      "PowerShell(drizzle-kit push*)",
      "PowerShell(drizzle-kit drop*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git reset * --hard*)",
      "PowerShell(git clean -f*)"
    ]
  }
}
