{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/domain-purity-check.mjs" },
          { "type": "command", "command": "node .claude/hooks/schema-change-reminder.mjs" },
          { "type": "command", "command": "node .claude/hooks/gated-module-warning.mjs" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run typecheck:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run db:generate:*)",
      "Bash(npm run format:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "PowerShell(npm run typecheck:*)",
      "PowerShell(npm run lint:*)",
      "PowerShell(npm run db:generate:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)"
    ]
  }
}
